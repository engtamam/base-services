    "/api/v1/auth/resend-verification": {
      "post": {
        "description": "Ask for another verification mail. ALWAYS 202, whatever the truth.\n\nThis route is unauthenticated, so every distinguishable outcome is an oracle: whether the\naddress is registered, whether it is already verified, whether it is in cooldown. All of them\nanswer the same way. A caller who owns the address learns the truth from their inbox, which is\nthe only place that should be telling them.",
        "operationId": "resend_verification_api_v1_auth_resend_verification_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Resend Verification Api V1 Auth Resend Verification Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resend Verification",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/tenant": {
      "post": {
        "description": "Choose ONE door and get a token scoped to it.\n\nThis is THE mint, and it is the only door between every company on the platform. The tenant\nthat ends up in the token is read off the membership row we find \u2014 never off `body.tenant`\n(T1). `body.tenant` is a request to be let in, not an assertion of where you already are.",
        "operationId": "select_tenant_api_v1_auth_tenant_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TenantIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Select Tenant Api V1 Auth Tenant Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Select Tenant",
        "tags": [
          "tenancy"
        ]
      },
      "x-available-when": "IDENTITY_MULTI_TENANT=true"
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "description": "Redeem a verification token. Single-use.\n\nUnknown, expired and already-spent are ONE answer on purpose. Distinguishing them tells an\nattacker holding a stale link whether the address exists and whether someone got there first,\nand none of those distinctions helps a legitimate user \u2014 who needs the same next step in\nevery case: ask for another mail.",
        "operationId": "verify_email_api_v1_auth_verify_email_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Verify Email Api V1 Auth Verify Email Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify Email",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/tenancy/members": {
      "get": {
        "description": "Who works HERE. Admin-gated, one tenant, paginated.\n\nTHE TENANT IS NOT A PARAMETER. It is read off the caller's token \u2014 the same membership row the\nmint verified. A `?tenant=` on a directory read is T1 wearing a different hat: it would let any\nadmin enumerate the staff of any company on the platform, and it would look like a feature.\n\nA caller with no tenant claim is REJECTED, never widened to \"all tenants\" (T8).",
        "operationId": "list_members_api_v1_tenancy_members_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Members Api V1 Tenancy Members Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Members",
        "tags": [
          "tenancy"
        ]
      },
      "post": {
        "description": "Staff THIS tenant. Admin-gated; the tenant comes off the token.\n\nIf the person already exists we grant a membership and touch nothing else \u2014 their credential\nis the key to every other company they work for, and an admin here has no claim on it (T2).",
        "operationId": "add_member_api_v1_tenancy_members_post",
        "requestBody": {
          "content": {
