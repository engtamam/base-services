    "/api/v1/auth/person/claim": {
      "post": {
        "description": "The invited human sets their OWN password. No token, no admin, no session \u2014 just the invite.\n\nSingle-use: redeeming consumes it. An invite that worked twice would be a password reset for\nanyone who ever saw the link.",
