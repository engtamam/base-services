    "/internal/privacy/erase": {
      "post": {
        "description": "Erase a data subject. Called by compliance-service during a DSAR fan-out.\n\nidentity owns the pseudonym LINKAGE, so this is the call that actually makes the person\nunlinkable everywhere else. Idempotent: a retry on an already-erased subject returns the same\nshape rather than failing, because a DSAR retries.",
        "operationId": "erase_subject_internal_privacy_erase_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Internal-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EraseIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Erase Subject Internal Privacy Erase Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Erase Subject",
        "tags": [
          "internal"
        ]
      }
    },
    "/internal/ratelimit/unblock": {
      "post": {
        "description": "Clear ONE rate-limit key. The operator's 3am remedy.\n\nSomeone WILL be locked out by a misconfigured limit or a shared NAT. If the only tool is\nFLUSHALL, the operator uses it and takes every other limit on the platform down with it. This\nclears exactly one key and nothing else \u2014 the surgical alternative to the sledgehammer.\n\nThe key is the composite key the policy built (e.g. `auth|s:<subject>`); an operator reads it\noff the throttled response's logs. It is internal-token gated: unblocking a limit is a platform\naction, not a tenant one.",
        "operationId": "ratelimit_unblock_internal_ratelimit_unblock_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Internal-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Token"
