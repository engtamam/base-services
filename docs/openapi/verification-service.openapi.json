        "summary": "Review Queue",
        "tags": [
          "v1",
          "verification"
        ]
      }
    },
    "/api/v1/verification/review/{verification_id}": {
      "post": {
        "description": "Approve or refuse a claim. The most privileged operation in this service.",
        "operationId": "decide_review_api_v1_verification_review__verification_id__post",
        "parameters": [
          {
            "in": "path",
            "name": "verification_id",
            "required": true,
            "schema": {
              "title": "Verification Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecideIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Decide Review Api V1 Verification Review  Verification Id  Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Decide Review",
        "tags": [
          "v1",
          "verification"
        ]
      }
    },
    "/api/v1/verification/status": {
      "get": {
        "description": "Is my claim currently good? `trusted` is computed against the clock, so an expired verdict\nreports as expired the moment it lapses rather than when a sweeper next runs.",
        "operationId": "claim_status_api_v1_verification_status_get",
        "parameters": [
          {
            "in": "query",
            "name": "claim_type",
            "required": true,
            "schema": {
              "title": "Claim Type",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Claim Status Api V1 Verification Status Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Claim Status",
        "tags": [
          "v1",
          "verification"
        ]
      }
    },
