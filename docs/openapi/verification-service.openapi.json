            },
            "description": "Successful Response"
          }
        },
        "summary": "My Claims",
        "tags": [
          "v1",
          "verification"
        ]
      },
      "post": {
        "description": "Check a claim about yourself. Rate-limited: verification calls cost money at the provider,\nand an unthrottled endpoint is both a bill and an enumeration oracle.",
        "operationId": "submit_claim_api_v1_verification_claims_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyIn"
