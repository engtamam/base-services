{
  "components": {
    "schemas": {
      "DecideIn": {
        "properties": {
          "approve": {
            "title": "Approve",
            "type": "boolean"
          },
          "document_id": {
            "default": "",
            "maxLength": 256,
            "title": "Document Id",
            "type": "string"
          },
          "note": {
            "default": "",
            "maxLength": 1024,
            "title": "Note",
            "type": "string"
          }
        },
        "required": [
          "approve"
        ],
        "title": "DecideIn",
        "type": "object"
      },
      "EraseIn": {
        "properties": {
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "tenant": {
            "title": "Tenant",
            "type": "string"
          }
        },
        "required": [
          "tenant",
          "subject"
        ],
        "title": "EraseIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyIn": {
        "properties": {
          "claim_type": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Claim Type",
            "type": "string"
          },
          "extra": {
            "additionalProperties": true,
            "title": "Extra",
            "type": "object"
          },
          "value": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "claim_type",
          "value"
        ],
        "title": "VerifyIn",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "verification-service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/ping": {
      "get": {
        "operationId": "admin_ping_api_v1_admin_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Admin Ping Api V1 Admin Ping Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Admin Ping",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/verification/claims": {
      "get": {
        "description": "Every verdict about ME. Scoped to the caller's own subject \u2014 never a lookup tool.",
        "operationId": "my_claims_api_v1_verification_claims_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response My Claims Api V1 Verification Claims Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "My Claims",
        "tags": [
          "v1",
          "verification"
        ]
      },
      "post": {
        "description": "Check a claim about yourself. Rate-limited: verification calls cost money at the provider,\nand an unthrottled endpoint is both a bill and an enumeration oracle.",
        "operationId": "submit_claim_api_v1_verification_claims_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Submit Claim Api V1 Verification Claims Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Claim",
        "tags": [
          "v1",
          "verification"
        ]
      }
    },
    "/api/v1/verification/review-queue": {
      "get": {
        "description": "Claims waiting on a human, oldest first.",
        "operationId": "review_queue_api_v1_verification_review_queue_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
