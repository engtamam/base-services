    "/api/v1/verification/claims": {
      "get": {
        "description": "Every verdict about ME. Scoped to the caller's own subject \u2014 never a lookup tool.",
        "operationId": "my_claims_api_v1_verification_claims_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response My Claims Api V1 Verification Claims Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "My Claims",
        "tags": [
          "v1",
          "verification"
        ]
      },
      "post": {
        "description": "Check a claim about yourself. Rate-limited: verification calls cost money at the provider,\nand an unthrottled endpoint is both a bill and an enumeration oracle.",
        "operationId": "submit_claim_api_v1_verification_claims_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Submit Claim Api V1 Verification Claims Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Claim",
        "tags": [
          "v1",
          "verification"
        ]
      }
    },
