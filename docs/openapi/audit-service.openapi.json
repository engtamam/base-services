    "/internal/privacy/erase": {
      "post": {
        "description": "Audit erases NOTHING \u2014 and says so, with a basis, and proves the chain still verifies.\n\nThe events carry a pseudonym, not an identity. Once identity-service deletes the linkage they\nname nobody. Redacting them instead would break the hash chain from that seq onward, which is\nthe one thing this service exists to make impossible.",
        "operationId": "erase_subject_internal_privacy_erase_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Internal-Token",
            "required": false,
            "schema": {
