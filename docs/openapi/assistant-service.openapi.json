    "/api/v1/assistant/branding": {
      "get": {
        "description": "What the widget should look like for this caller's tenant and surface.\n\nResolution is specific-beats-general \u2014 surface over tenant over deployment default \u2014 and it\nLAYERS rather than replaces, so a surface that only wants a different accent inherits the logo\nand the name instead of restating them. Restating is what makes four UIs drift apart.",
        "operationId": "branding_api_v1_assistant_branding_get",
        "parameters": [
          {
            "in": "query",
            "name": "surface",
            "required": false,
            "schema": {
              "default": "",
              "title": "Surface",
              "type": "string"
            }
