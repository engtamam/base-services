              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Secrets",
        "tags": [
          "operator"
        ]
      },
      "put": {
        "description": "Set or rotate a credential. The previous one stays valid for a bounded window.\n\nAudited BEFORE the write: a change the log cannot take must not happen, and here the old value\nis overwritten by the action itself, so an unrecorded rotation is unreconstructable.",
        "operationId": "set_secret_api_v1_operator_secrets_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SecretIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Set Secret Api V1 Operator Secrets Put",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Secret",
        "tags": [
          "operator"
        ]
      }
    },
