    "/internal/search/suggest": {
      "get": {
        "description": "Prefix suggest for a PEER service calling on its own caller's behalf.\n\nThe user route (/api/v1/search/suggest) takes the tenant from the caller's JWT \u2014 which a peer\nlike operations, holding only TOKEN_PUBLIC_KEY, can VERIFY but never MINT (identity-service alone\nkeeps the signing key). So it could never present the Bearer token that route requires, and every\nconsole phone-prefix suggest failed 401, silently, from day one. This is the token-authed twin:\nsame SearchService.suggest(), tenant explicit because the peer already resolved it. A READ, so no\naudit row \u2014 matching the user route and the internal manifest/health reads.",
        "operationId": "internal_suggest_internal_search_suggest_get",
        "parameters": [
          {
            "in": "query",
            "name": "index",
            "required": true,
            "schema": {
              "title": "Index",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "prefix",
            "required": true,
            "schema": {
              "title": "Prefix",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Internal-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Internal Suggest Internal Search Suggest Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
