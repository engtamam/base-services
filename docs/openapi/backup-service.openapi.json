    "/internal/backup/export": {
      "post": {
        "description": "Produce a sealed, checksummed archive of this service's declared data.\n\nCalled by backup-service, on a schedule, over the internal token. What this service holds is\ndeclared in app/backup_manifest.py; how it is read lives in core/backup.py. The orchestrator\nstores the archive and never sees the plaintext.",
        "operationId": "backup_export_internal_backup_export_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Internal-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BackupExportIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Backup Export Internal Backup Export Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Backup Export",
        "tags": [
          "internal"
        ]
      }
    },
