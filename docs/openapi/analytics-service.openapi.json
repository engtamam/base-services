            "type": "string"
          },
          "tenant": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Tenant",
            "type": "string"
          },
          "value": {
            "default": 0.0,
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "tenant"
        ],
        "title": "EventIn",
        "type": "object"
