            "title": "Tenant",
            "type": "string"
          }
        },
        "required": [
          "tenant",
          "subject"
        ],
        "title": "EraseIn",
        "type": "object"
      },
      "ForceIn": {
        "properties": {
          "reason": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "requirement": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Requirement",
            "type": "string"
          },
          "ttl_seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
