    "/api/v1/onboarding/admin/provisioning/{subject}": {
      "get": {
        "description": "A customer's last provisioning run \u2014 what completed, what was rolled back, and the residue /\nunfinished cleanup still outstanding. The read an operator looks at before deciding to resume.",
        "operationId": "provisioning_run_api_v1_onboarding_admin_provisioning__subject__get",
        "parameters": [
          {
            "in": "path",
            "name": "subject",
            "required": true,
