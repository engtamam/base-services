            "description": "Validation Error"
          }
        },
        "summary": "Claim Grant",
        "tags": [
          "v1",
          "onboarding"
        ]
      }
    },
    "/api/v1/onboarding/next": {
      "post": {
        "description": "What is still unsatisfied for me, right now.\n\nPOST rather than GET because the audience profile decides which flow applies and belongs in a\nbody, not in a query string that lands in access logs.\n\nEvaluated live on every call: a verification that expired since the last request shows as\nunsatisfied again, and anything it blocked is blocked again. Nothing here is remembered.",
        "operationId": "whats_next_api_v1_onboarding_next_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Whats Next Api V1 Onboarding Next Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Whats Next",
        "tags": [
          "v1",
          "onboarding"
        ]
      }
    },
    "/api/v1/onboarding/provision": {
      "post": {
        "description": "Create what this flow says signup creates \u2014 atomically, or not at all.\n\nSafe to call twice: every step carries a key derived from the tenant, subject and step name, so\na customer who times out and presses the button again gets the same tenant rather than a\nsecond one. If a later step fails, the earlier ones are undone \u2014 the orphan-tenant failure this\nwas built to prevent.",
        "operationId": "provision_api_v1_onboarding_provision_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Provision Api V1 Onboarding Provision Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Provision",
        "tags": [
          "v1",
          "onboarding"
        ]
      }
    },
