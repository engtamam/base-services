    "/api/v1/onboarding/admin/flows": {
      "get": {
        "description": "The flow catalogue \u2014 which onboarding flows exist, and each flow's requirements and the\nresources it provisions. The see-before-you-act read: an operator inspecting a stuck customer\nneeds to know which flow they are on and what it demands, without reading the deployment config.",
        "operationId": "list_flows_api_v1_onboarding_admin_flows_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
