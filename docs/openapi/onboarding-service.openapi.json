            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProfileIn": {
        "description": "What decides WHICH flow applies. Free-form on purpose: a platform's audiences are its own,\nand `account_type` / `joined_by` are examples rather than a schema.",
