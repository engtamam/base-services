          }
        },
        "summary": "Provisioning Run",
        "tags": [
          "v1",
          "onboarding"
        ]
      }
    },
    "/api/v1/onboarding/admin/resume/{subject}": {
      "post": {
        "description": "Re-attempt the compensation a failed provisioning could not finish for this customer.\n\nAudited: it re-runs undo work against downstream services on a customer's behalf. It never\nre-runs the forward steps (those succeeded), so it is safe to call repeatedly \u2014 it works the\n'unfinished' queue and returns what is left. Nothing to resume is a clean, recorded no-op.",
        "operationId": "resume_provisioning_api_v1_onboarding_admin_resume__subject__post",
        "parameters": [
          {
            "in": "path",
            "name": "subject",
            "required": true,
            "schema": {
              "title": "Subject",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Resume Provisioning Api V1 Onboarding Admin Resume  Subject  Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resume Provisioning",
        "tags": [
          "v1",
          "onboarding"
        ]
      }
    },
    "/api/v1/onboarding/claim-grant": {
      "post": {
        "description": "Issue any grant whose requirement is now satisfied and unblocked.\n\nIdempotent by construction: the grant service keys on a verified identity, so calling this\nrepeatedly \u2014 or racing it \u2014 yields one grant.",
        "operationId": "claim_grant_api_v1_onboarding_claim_grant_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileIn"
              }
            }
          },
          "required": true
