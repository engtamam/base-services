              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Effective Config",
        "tags": [
          "operator"
        ]
      },
      "put": {
        "description": "Override one policy value. Refused if the boot guard would refuse it.",
