    "/internal/notifications/drain": {
      "post": {
        "description": "Re-attempt every queued delivery whose backoff has expired.\n\nA retry nobody runs is not a retry \u2014 `queued` would just be a prettier word for `lost`. Drive\nthis from the chart's cronJobs (it exists for exactly this), or any scheduler:\n\n    cronJobs:\n      - name: notify-drain\n        schedule: \"*/1 * * * *\"\n        path: /internal/notifications/drain\n\nIdempotent and safe to run concurrently-ish: each delivery carries its own next_attempt_ts, so\na tick that arrives early simply skips it.",
        "operationId": "drain_queue_internal_notifications_drain_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Internal-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Drain Queue Internal Notifications Drain Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Drain Queue",
        "tags": [
          "internal"
        ]
      }
    },
