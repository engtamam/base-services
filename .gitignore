# =============================================================================
# base-services — .gitignore
#
# The first rule matters most: a virtualenv is ~108 MB and there are 18 of them.
# The second matters more: a credential committed once is a credential rotated,
# not a commit reverted. `tools/ci/run_all_gates.sh --only safety:secrets`
# refuses a diff that introduces one; this stops it reaching the diff at all.
# =============================================================================

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# ── Virtualenvs (one per service; never committed) ──────────────────────────
.venv/
venv/
ENV/

# ── Test / tooling caches ───────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ── Secrets. Nothing here is ever "just for local dev". ─────────────────────
.env
.env.*
!.env.example
!.env.sample
.secrets
*.pem
*.key
!**/testdata/**/*.pem          # fixtures, if any, must be explicit
id_rsa*
*.p12
*.pfx
.detect-secrets.baseline.local

# ── Runtime state written by the services ───────────────────────────────────
.objectstore/
*.sqlite
*.sqlite3
*.db

# ── Build / release artifacts ───────────────────────────────────────────────
sbom.json
sbom.xml
*.tar.gz
deploy/pinned/

# ── Editors / OS ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Local scratch ───────────────────────────────────────────────────────────
scratch/
tmp/
*.log

# local multi-service test env (not a service .venv)
.venv-test/

# parallel test runner output
.test-logs/

# The filled product config. Same rule as .env: the EXAMPLE is committed, the real
# one is not. It carries the legal entity, VAT number and support contacts.
# config/product.identifiers.lock.json IS committed — the freeze needs a baseline.
config/product.json

# ── Legal ───────────────────────────────────────────────────────────────────
# Executed agreements name real counterparties and real fees. They do not belong
# in a source repository, and a signed PDF committed by mistake cannot be unsent —
# it lives in the history of every clone that ever pulled it.
/legal/

# Agent worktrees: real git worktrees, never repo content.
.claude/worktrees/

# Transient local release build logs (see scratchpad/build_release.sh)
.release-logs/
