# =============================================================================
# connector-service — environment configuration (EXAMPLE)
# Copy to .env and fill real values. NEVER commit a real .env.
# Every knob the service reads is listed here (zero-hardcoded principle).
# =============================================================================

# ── Identity ────────────────────────────────────────────────────────────────
SERVICE_NAME=connector-service
SERVICE_VERSION=0.1.0
# development | production | test
ENV=development

# ── HTTP server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warning | error
LOG_LEVEL=info

# ── Request hardening ───────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000
BODY_LIMIT_BYTES=1048576

# ── Security headers ────────────────────────────────────────────────────────
# CSP frame-ancestors: who may embed this service in a frame. Default: nobody.
ALLOWED_FRAME_ANCESTORS='none'

# ── Internal service-to-service auth (REQUIRED, >= 32 chars) ────────────────
# Generate a strong random value, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
INTERNAL_SERVICE_TOKEN=

# =============================================================================
# Ports & adapters (Phase 2) — choose a driver per port.
# Defaults below are ZERO-INFRA (no external system). Point at real infra by
# setting the driver + its connection value. Unknown driver => refuse to boot.
# =============================================================================

# datastore: memory | postgres
DATASTORE_DRIVER=memory
DATASTORE_DSN=

# cache: memory | redis
CACHE_DRIVER=memory
CACHE_URL=

# event bus: memory | redis
EVENTBUS_DRIVER=memory
EVENTBUS_URL=

# queue: memory | redis
QUEUE_DRIVER=memory
QUEUE_URL=

# object store: local | s3
OBJECTSTORE_DRIVER=local
OBJECTSTORE_ROOT=./.objectstore
OBJECTSTORE_BUCKET=
OBJECTSTORE_ENDPOINT_URL=

# secrets: env | file | vault
SECRETS_DRIVER=env
SECRETS_FILE=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_PATH=

# token verifier: null | hs256 | rs256 | jwks
#   null  = deny all (default, until you configure real auth)
#   rs256/jwks preferred (verify-only, cannot forge); hs256 = shared secret
TOKEN_VERIFIER_DRIVER=null
TOKEN_ISSUER=
TOKEN_AUDIENCE=
TOKEN_HS256_SECRET=
TOKEN_PUBLIC_KEY=
TOKEN_JWKS_URL=

# rate limiter: memory | redis
RATELIMITER_DRIVER=memory
RATELIMIT_URL=
RATELIMIT_MAX=100
RATELIMIT_WINDOW_SECONDS=60

# telemetry: stdout
TELEMETRY_DRIVER=stdout

# =============================================================================
# CWE self-guard (Phase 3) — before/after-step self-checks
# =============================================================================
CWE_GUARD_ENABLED=true
# SSRF allowlist (CWE-918): comma-separated hostnames egress may target.
EGRESS_ALLOWED_HOSTS=
# Optional override for the step->CWE map (TOML). Empty = bundled default.
CWE_STEP_MAP_FILE=

# =============================================================================
# connector-service (Phase 22) — third-party integrations
# =============================================================================
CONNECTOR_PROVIDER_DRIVER=null       # null | recording | oauth2-rest (spec-driven) | slack | hubspot
CLOCK_DRIVER=system                  # system | manual (tests)
CREDENTIAL_SEAL_KEY=                 # AES-256-GCM key for credentials at rest
CONNECTION_CACHE_TTL_SECONDS=60      # hot path: token resolution
TOKEN_REFRESH_SKEW_SECONDS=60        # refresh early (clock skew safe)
SYNC_BATCH_SIZE=100
SYNC_MAX_ATTEMPTS=5                  # then dead-letter
SYNC_RETRY_BASE_SECONDS=5
SYNC_RETRY_MAX_SECONDS=3600
SYNC_RETRY_JITTER=true
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=300
HTTP_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=1048576
INSTANCE_REQUIRE_HTTPS=true          # SSRF guard on self-hosted instance URLs
INSTANCE_ALLOW_PRIVATE_IPS=false     # dev/test only — NEVER true in production
INSTANCE_ALLOWED_HOSTS=
CONNECTOR_LIST_LIMIT=100
