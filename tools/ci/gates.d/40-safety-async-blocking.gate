#!/usr/bin/env bash
gate_name="safety:async-blocking"
gate_desc="no blocking I/O primitive runs directly on the async event loop (direct, heavy, indirect)"
gate_protects="A single-worker async service that calls a blocking primitive (urllib urlopen,
requests.*, time.sleep, subprocess.*, os.system, a bare open(), a slow hash) inside an
async def freezes the WHOLE worker — every other request AND the liveness probe — for the
call's full timeout when the remote is slow or hung. It shipped once (v0.18.3: an HTTP
audit sink froze /healthz) and audits found more, including a urlopen hidden one function
away behind post_json() on billing's money path (v0.19.14). Three detections: DIRECT (the
async body blocks), HEAVY (open()/pbkdf2/scrypt/bcrypt), and INDIRECT (the async body calls
a plain def that itself blocks). The fix is one line, await asyncio.to_thread. A call in a
nested def/lambda (the to_thread target) or passed by NAME to to_thread is fine. Patterns
are config; the too-generic-name blocklist is narrowed, never guessed; exceptions are named."
gate_needs="python"
gate_env=""
gate_subject="tools/ci/check_async_blocking.py"
gate_units=0
gate_slow=0

gate_main() { "$PY" tools/ci/check_async_blocking.py; }

# A gate that cannot fail is decoration. Prove every detection fires AND the scope-aware indirect
# resolution neither misses a cross-file import nor false-positives on a cross-file NAME COLLISION
# (the whole point of dropping the blocklist), and that the real offload shapes stay clean.
gate_selftest() {
  "$PY" -c "
import sys, pathlib, tempfile, textwrap
sys.path.insert(0, 'tools/ci')
import check_async_blocking as c
d = pathlib.Path(tempfile.mkdtemp()); (d/'app').mkdir()

def W(rel, text): (d/'app'/rel).write_text(textwrap.dedent(text))
def scan(): return c.scan_service(d, c._module_blocking_defs([d]))
def clear():
    for f in (d/'app').glob('*.py'): f.unlink()

# 1. DIRECT
clear(); W('m.py', '''
    import urllib.request
    async def check():
        with urllib.request.urlopen(req) as r: return r.read()
''')
assert scan(), 'missed a direct blocking urlopen'

# 2. HEAVY (bare open)
clear(); W('m.py', '''
    async def check():
        with open(\"/x\", \"rb\") as f: return f.read()
''')
assert scan(), 'missed a heavy open()'

# 3. INDIRECT same-file bare def
clear(); W('m.py', '''
    import urllib.request
    def fetch_thing(u): return urllib.request.urlopen(u).read()
    async def check(): return fetch_thing(\"http://x\")
''')
assert scan(), 'missed an indirect bare-name call'

# 4. INDIRECT self-method (same file) — the onboarding/ticket class
clear(); W('m.py', '''
    import urllib.request
    class C:
        def _post(self, u): return urllib.request.urlopen(u).read()
        async def go(self): return self._post(\"http://x\")
''')
assert scan(), 'missed an indirect self._post() call'

# 5. INDIRECT cross-file IMPORT (post_json shape) — must still be caught
clear()
W('http.py', '''
    import urllib.request
    def post_json(u): return urllib.request.urlopen(u).read()
''')
W('caller.py', '''
    from app.http import post_json
    async def credit(): return post_json(\"http://x\")
''')
assert scan(), 'missed an indirect cross-file imported blocking helper'

# 6. CROSS-FILE COLLISION must NOT flag (the blocklist-free win): caller._post is its OWN safe method,
#    an unrelated file has a blocking _post — no import, no shared scope.
clear()
W('blocking.py', '''
    import urllib.request
    class B:
        def _post(self, u): return urllib.request.urlopen(u).read()
''')
W('safe.py', '''
    class S:
        def _post(self, u): return 42
        async def go(self): return self._post(\"x\")
''')
assert not scan(), 'false-positived on a cross-file name collision (_post)'

# 7. NEGATIVES — real offload shapes clean.
clear(); W('m.py', '''
    import asyncio, urllib.request
    def fetch_thing(u): return urllib.request.urlopen(u).read()
    async def a():
        def _do(): return urllib.request.urlopen(req).read()
        return await asyncio.to_thread(_do)
    async def b(): return await asyncio.to_thread(fetch_thing, \"http://x\")
    async def cc(): return await asyncio.to_thread(lambda: open(\"/x\", \"rb\").read())
''')
assert not scan(), 'false-positived on a to_thread offload (def/name/lambda)'
sys.exit(0)
" >/dev/null 2>&1
}
