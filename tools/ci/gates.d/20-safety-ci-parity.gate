#!/usr/bin/env bash
gate_name="safety:ci-parity"
gate_desc="the workflow runs exactly the gates this runner discovers"
gate_protects="A gate defined but never run by CI is decoration; a workflow step naming a gate
that does not exist is a lie. Both directions are checked. Descriptions are no
longer a third place to drift: they live in the gate file, so --list is generated."
gate_needs="python"
gate_env=""
gate_subject="tools/ci/check_ci_parity.py"
gate_units=0
gate_slow=0

gate_main() { "$PY" tools/ci/check_ci_parity.py; }
