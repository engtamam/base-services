#!/usr/bin/env bash
gate_name="safety:secrets"
gate_desc="no credential material in the diff"
gate_protects="Scans the branch diff (vs merge-base) for private keys, .secrets and real .env
files. Committing a credential is not a code review comment; it is a rotation.
It cannot un-leak one."
gate_needs="git"
gate_env=""
gate_subject=""
gate_units=0
gate_slow=0

gate_main() {
  local base files hits
  base="$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null || true)"
  if [ -n "$base" ]; then
    files="$(git diff --name-only "$base"...HEAD 2>/dev/null)"
  else
    files="$(git diff --name-only HEAD 2>/dev/null; git diff --name-only --cached 2>/dev/null)"
  fi
  files="$(printf '%s\n' "$files" | sort -u | sed '/^$/d')"
  if [ -z "$files" ]; then echo "  (no changed files in range — nothing to guard)"; return 0; fi
  # .env.example / .env.sample are documentation, not credentials; .secrets.baseline is the
  # detect-secrets BASELINE (hashes of scanned locations) — the opposite of a leaked secret, and
  # committed by every service, so it must not be mistaken for one.
  hits="$(printf '%s\n' "$files" \
    | grep -iE '\.pem$|\.key$|(^|/)id_rsa|(^|/)\.secrets|(^|/)\.env$' \
    | grep -vE '\.example$|\.sample$|\.secrets\.baseline$' || true)"
  if [ -n "$hits" ]; then
    echo "  REFUSED — the diff introduces credential material:"
    printf '    %s\n' $hits
    return 1
  fi
  echo "  clean — no credential paths in the diff."
  return 0
}

# A gate that cannot fail is decoration. This one must refuse a known-bad path.
gate_selftest() {
  printf 'secret\n' > "$RUN_TMP/probe.pem"
  ! ( printf '%s\n' "$RUN_TMP/probe.pem" \
      | grep -iE '\.pem$|\.key$|(^|/)id_rsa|(^|/)\.secrets|(^|/)\.env$' \
      | grep -vE '\.example$|\.sample$' >/dev/null ) && return 1
  return 0
}
