#!/usr/bin/env bash
gate_name="coverage:services"
gate_desc="every service carries the guards we learned the hard way"
gate_protects="probe contract + hot-path benchmark + config-knob guard + deploy values +
postgres contract. New services inherit the bar automatically; exceptions live in
a SHRINKING allowlist, and a stale entry FAILS."
gate_needs="python"
gate_env=""
gate_subject="tools/ci/check_service_coverage.py"
gate_units=1
gate_slow=0

gate_main() { "$PY" tools/ci/check_service_coverage.py; }
