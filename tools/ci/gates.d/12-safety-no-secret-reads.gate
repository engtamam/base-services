#!/usr/bin/env bash
gate_name="safety:no-secret-reads"
gate_desc="a stored credential never leaves through an API"
gate_protects="Operator-managed credentials are sealed at rest, but the guarantee that matters is
not encryption — SecretStore.get() returns plaintext by necessity, because an SMS
client cannot authenticate with a masked string. The whole property rests on one
rule: no HTTP handler returns that value.

A rule about discipline is the kind this repo has repeatedly found insufficient. One
helpful 'return {\"key\": await store.get(...)}' added while debugging would hand every
tenant's provider credentials to anyone holding the panel capability, and it would
read as entirely reasonable in review. So it is mechanical instead.

Scoped to API modules that reach the store, so it covers each service the day it
migrates. It does NOT flag a freshly minted secret returned once to its own owner
(webhook rotation, TOTP enrollment) — that is a different act, and a gate that is
wrong about real code on day one is a gate people learn to argue with."
gate_needs="python"
gate_env=""
gate_subject="services/*/app/api"
gate_units=0
gate_slow=0

gate_main() {
  "$PY" tools/ci/check_secret_reads.py || return 1
  return 0
}

# A gate that cannot fail is decoration. Plant the exact mistake this exists to catch — an API
# module handing back a plaintext credential — and require a refusal.
gate_selftest() {
  local probe="$RUN_TMP/svc-probe/app/api/v1"
  mkdir -p "$probe"
  cat > "$probe/leak.py" <<'PY'
from app.core.secret_store import SecretStore


async def show(request):
    return {"api_key": await secret_store.get(tenant="t", name="sms")}
PY
  ! ( SERVICES_ROOT="$RUN_TMP" "$PY" tools/ci/check_secret_reads.py >/dev/null 2>&1 )
}
